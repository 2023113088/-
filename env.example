# 本地/CI 覆盖用（勿提交真实密钥）。复制为 .env 后 docker compose 会自动读取并替换 compose 中的 ${变量}
# cp env.example .env

# MySQL（仅影响 compose 里 mysql 与 JDBC 无关；业务库账号在 docker/mysql/init 脚本）
MYSQL_ROOT_PASSWORD=root_dev_change_me

# 业务库账号（须与 init 脚本里 GRANT 的密码一致，改脚本或改此处二选一）
MYSQL_USER=library
MYSQL_PASSWORD=library_secret_change_me

# 网关与用户服务必须一致（≥32 字节）
APP_JWT_SECRET=library-docker-jwt-secret-must-be-32bytes-min!!

# 借阅调图书库存接口；须与 book / borrow 的 app.internal.api-token 一致
INTERNAL_SERVICE_TOKEN=internal-service-token-min-16-chars!!

# 宿主机端口（与其它项目冲突时改这里，容器内端口不变）
NGINX_HOST_PORT=18888
CONFIG_SERVER_HOST_PORT=8888
EUREKA_HOST_PORT=8761
USER_SERVICE_HOST_PORT=9001
BOOK_SERVICE_HOST_PORT=9002
BORROW_SERVICE_HOST_PORT=9003
GATEWAY_HOST_PORT=18080
MYSQL_HOST_PORT=13306
